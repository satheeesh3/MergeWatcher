{
  "name": "mergewatcher",
  "displayName": "Merge Watcher",
  "description": "Automatically detects Git conflicts before pull/merge. No surprises.",
  "version": "0.1.19",
  "publisher": "satheeesh3",
  "icon": "media/icon.png",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/satheeesh3/MergeWatcher.git"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "SCM Providers",
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/src/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "mergeWatcher.start",
        "title": "Merge Watcher: Start Watching"
      },
      {
        "command": "mergeWatcher.stop",
        "title": "Merge Watcher: Stop Watching"
      },
      {
        "command": "mergeWatcher.checkNow",
        "title": "Merge Watcher: Check Now",
        "icon": "$(refresh)"
      },
      {
        "command": "mergeWatcher.showStatus",
        "title": "Merge Watcher: Show Status"
      },
      {
        "command": "mergeWatcher.resumeWatchingAll",
        "title": "Merge Watcher: Resume Watching All Repositories"
      },
      {
        "command": "mergeWatcher.treeViewDiff",
        "title": "View Diff",
        "icon": "$(diff)"
      },
      {
        "command": "mergeWatcher.treeOpenFile",
        "title": "Open File",
        "icon": "$(go-to-file)"
      },
      {
        "command": "mergeWatcher.treeStopWatching",
        "title": "Stop Watching",
        "icon": "$(circle-slash)"
      },
      {
        "command": "mergeWatcher.treeResumeWatching",
        "title": "Resume Watching",
        "icon": "$(debug-start)"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "mergeWatcher",
          "title": "Merge Watcher",
          "icon": "media/activitybar-icon.png"
        }
      ]
    },
    "views": {
      "mergeWatcher": [
        {
          "id": "mergeWatcher.repositoriesView",
          "name": "Repositories"
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "mergeWatcher.checkNow",
          "when": "view == mergeWatcher.repositoriesView",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "mergeWatcher.treeViewDiff",
          "when": "view == mergeWatcher.repositoriesView && viewItem == repo-conflict",
          "group": "inline@1"
        },
        {
          "command": "mergeWatcher.treeOpenFile",
          "when": "view == mergeWatcher.repositoriesView && viewItem == repo-conflict",
          "group": "inline@2"
        },
        {
          "command": "mergeWatcher.treeStopWatching",
          "when": "view == mergeWatcher.repositoriesView && viewItem =~ /^repo-(synced|behind|conflict|error)$/",
          "group": "inline@3"
        },
        {
          "command": "mergeWatcher.treeResumeWatching",
          "when": "view == mergeWatcher.repositoriesView && viewItem == repo-stopped",
          "group": "inline@3"
        }
      ],
      "commandPalette": [
        {
          "command": "mergeWatcher.treeViewDiff",
          "when": "false"
        },
        {
          "command": "mergeWatcher.treeOpenFile",
          "when": "false"
        },
        {
          "command": "mergeWatcher.treeStopWatching",
          "when": "false"
        },
        {
          "command": "mergeWatcher.treeResumeWatching",
          "when": "false"
        }
      ]
    },
    "configuration": {
      "title": "Merge Watcher",
      "properties": {
        "mergeWatcher.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable or disable Merge Watcher."
        },
        "mergeWatcher.intervalSeconds": {
          "type": "number",
          "default": 30,
          "minimum": 5,
          "description": "How often (in seconds) to fetch the remote and check for conflicts."
        },
        "mergeWatcher.remote": {
          "type": "string",
          "default": "origin",
          "description": "The Git remote to compare against."
        },
        "mergeWatcher.notifyOnConflict": {
          "type": "boolean",
          "default": true,
          "description": "Show a warning notification when a potential conflict is detected."
        },
        "mergeWatcher.excludedRepositories": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Repository names or paths to permanently exclude from watching."
        },
        "mergeWatcher.maxConcurrentChecks": {
          "type": "number",
          "default": 4,
          "minimum": 1,
          "description": "How many repositories to fetch/check at the same time. Lower this on low-resource machines to reduce CPU and memory use."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile",
    "test": "mocha \"out/test/**/*.test.js\" --ui tdd"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.6",
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^3.9.2",
    "mocha": "^10.4.0",
    "typescript": "^5.4.0"
  }
}
